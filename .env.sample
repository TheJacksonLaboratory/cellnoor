# Because `docker compose` can be kind of heavy, you might want to use this `.env` to start a dev version of the
# app (over unencrypted HTTP)

# Passwords for initial db-setup
CELLNOOR_DB_ROOT_PASSWORD_ROOT=""

# cellnoor-api configuration
CELLNOOR_API__DB__PASSWORD=""
CELLNOOR_API__DB__DBNAME="postgres"
CELLNOOR_API__STATIC_FILES_DIR=""

# cellnoor-auth configuration
CELLNOOR_AUTH__DB_HOST="localhost"
CELLNOOR_AUTH__DB_PASSWORD=""
CELLNOOR_AUTH__DB_NAME="postgres"
CELLNOOR_AUTH__AUTH_SECRET=""
CELLNOOR_AUTH__MICROSOFT_ENTRA_TENANT_ID=""
CELLNOOR_AUTH__MICROSOFT_ENTRA_CLIENT_ID=""
CELLNOOR_AUTH__MICROSOFT_ENTRA_CLIENT_SECRET=""
