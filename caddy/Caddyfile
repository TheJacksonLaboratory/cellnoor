api.{$CELLNOOR_PUBLIC_BASE_URL} {
    encode
    {$CELLNOOR_TLS_SETTINGS}
    reverse_proxy unix+h2c/{$CELLNOOR_API_SOCKET}
}

{$CELLNOOR_PUBLIC_BASE_URL} {
    encode
    {$CELLNOOR_TLS_SETTINGS}

    handle /api/auth/* {
        reverse_proxy unix/{$CELLNOOR_AUTH_SOCKET}
    }

    handle /api/* {
        reverse_proxy unix+h2c/{$CELLNOOR_API_SOCKET}
    }

    handle_path /files/* {
        root {$CELLNOOR_STATIC_FILES_DIR}

        forward_auth unix+h2c/{$CELLNOOR_API_SOCKET} {
            uri /file-auth{path}
        }

        file_server browse {
            precompressed
        }
    }

    handle {
        root {$CELLNOOR_UI_DIR}
        try_files {path} /index.html
        file_server
    }
}
