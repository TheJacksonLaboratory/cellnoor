  "components": {
    "securitySchemes": {
      "api_token": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "ApiError": {
        "anyOf": [
          { "$ref": "#/components/schemas/AuthError" },
          { "$ref": "#/components/schemas/DatabaseError" }
        ]
      },
      "AuthError": {
        "oneOf": [
          {
            "type": "object",
            "properties": { "type": { "type": "string", "const": "database" } },
            "allOf": [{ "$ref": "#/components/schemas/DatabaseError" }],
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string", "const": "invalid_auth_token" }
            },
            "required": ["type", "message"]
          },
          {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string", "const": "no_auth_token_found" }
            },
            "required": ["type", "message"]
          },
          {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string", "const": "other" }
            },
            "required": ["type", "message"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "permission_denied" }
            },
            "required": ["type"]
          }
        ]
      },
      "CreatePersonError": {
        "oneOf": [
          {
            "type": "object",
            "properties": { "type": { "type": "string", "const": "database" } },
            "allOf": [{ "$ref": "#/components/schemas/DatabaseError" }],
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "invalid_email" }
            },
            "required": ["type"]
          }
        ]
      },
      "DatabaseError": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string", "const": "data" }
            },
            "required": ["type", "message"]
          },
          {
            "type": "object",
            "properties": {
              "fields": { "type": "array", "items": { "type": "string" } },
              "resource": { "type": "string" },
              "type": { "type": "string", "const": "duplicate_resource" },
              "values": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["type", "resource", "fields", "values"]
          },
          {
            "type": "object",
            "properties": {
              "referenced_resource": { "type": "string" },
              "resource": { "type": "string" },
              "type": { "type": "string", "const": "invalid_reference" },
              "value": { "type": ["string", "null"] }
            },
            "required": ["type", "resource", "referenced_resource"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "resource_not_found" }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string", "const": "other" }
            },
            "required": ["type", "message"]
          }
        ]
      },
      "Institution": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "links": { "$ref": "#/components/schemas/Links" },
          "name": { "type": "string" }
        },
        "required": ["id", "name", "links"]
      },
      "InstitutionFilter": {
        "type": "object",
        "properties": {
          "ids": {
            "type": ["array", "null"],
            "default": null,
            "items": { "type": "string", "format": "uuid" }
          },
          "names": {
            "type": ["array", "null"],
            "default": null,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      },
      "InstitutionOrderBy": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "descending": { "type": ["boolean", "null"] },
              "field": { "type": "string", "const": "id" }
            },
            "required": ["field"]
          },
          {
            "type": "object",
            "properties": {
              "descending": { "type": ["boolean", "null"] },
              "field": { "type": "string", "const": "name" }
            },
            "required": ["field"]
          }
        ]
      },
      "Link": {
        "anyOf": [
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ]
      },
      "Links": {
        "type": "object",
        "additionalProperties": { "$ref": "#/components/schemas/Link" }
      },
      "NewInstitution": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        },
        "required": ["id", "name"]
      },
      "NewPerson": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "institution_id": { "type": "string", "format": "uuid" },
          "microsoft_entra_oid": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "name": { "type": "string" },
          "orcid": { "type": ["string", "null"] }
        },
        "required": ["name", "institution_id", "email"]
      },
      "NewProject": {
        "type": "object",
        "properties": {
          "ended_at": { "type": "string", "format": "date-time" },
          "name": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time" }
        },
        "required": ["name", "started_at", "ended_at"]
      },
      "Person": {
        "type": "object",
        "properties": {
          "email": { "type": ["string", "null"] },
          "email_verified": { "type": "boolean" },
          "id": { "type": "string", "format": "uuid" },
          "institution": { "$ref": "#/components/schemas/Institution" },
          "institution_id": { "type": "string", "format": "uuid" },
          "links": { "$ref": "#/components/schemas/Links" },
          "microsoft_entra_oid": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "name": { "type": "string" },
          "orcid": { "type": ["string", "null"] }
        },
        "required": [
          "id",
          "name",
          "institution_id",
          "email_verified",
          "links",
          "institution"
        ]
      },
      "PersonFilter": {
        "type": "object",
        "properties": {
          "emails": {
            "type": ["array", "null"],
            "default": null,
            "items": { "type": "string" }
          },
          "ids": {
            "type": ["array", "null"],
            "default": null,
            "items": { "type": "string", "format": "uuid" }
          },
          "institution_ids": {
            "type": ["array", "null"],
            "default": null,
            "items": { "type": "string", "format": "uuid" }
          },
          "microsoft_entra_oids": {
            "type": ["array", "null"],
            "default": null,
            "items": { "type": "string", "format": "uuid" }
          },
          "names": {
            "type": ["array", "null"],
            "default": null,
            "items": { "type": "string" }
          },
          "orcids": {
            "type": ["array", "null"],
            "default": null,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      },
      "PersonOrderBy": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "descending": { "type": ["boolean", "null"] },
              "field": { "type": "string", "const": "id" }
            },
            "required": ["field"]
          },
          {
            "type": "object",
            "properties": {
              "descending": { "type": ["boolean", "null"] },
              "field": { "type": "string", "const": "name" }
            },
            "required": ["field"]
          },
          {
            "type": "object",
            "properties": {
              "descending": { "type": ["boolean", "null"] },
              "field": { "type": "string", "const": "email" }
            },
            "required": ["field"]
          },
          {
            "type": "object",
            "properties": {
              "descending": { "type": ["boolean", "null"] },
              "field": { "type": "string", "const": "email_verified" }
            },
            "required": ["field"]
          },
          {
            "type": "object",
            "properties": {
              "descending": { "type": ["boolean", "null"] },
              "field": { "type": "string", "const": "institution_id" }
            },
            "required": ["field"]
          },
          {
            "type": "object",
            "properties": {
              "descending": { "type": ["boolean", "null"] },
              "field": { "type": "string", "const": "orcid" }
            },
            "required": ["field"]
          },
